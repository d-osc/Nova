{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "incremental": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@nova/jsx",
    "baseUrl": ".",
    "paths": {
      "@models/*": ["src/models/*"]
    }
  }
}

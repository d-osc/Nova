{
  "name": "test262-upstream-full",
  "edition": "upstream-main",
  "root": "../../../build/qualification/upstream/test262/test",
  "pattern": "**/*.js",
  "harness": "../../../build/qualification/upstream/test262/harness",
  "official_harness": true,
